    private async void OnVirtualCollectionSortChanged(object? sender, EventArgs e)
    {
        await InvokeAsync(async () =>
        {
            try
            {
                Console.WriteLine("Sort changed! Moving to first page...");

                // Reset về trang đầu tiên
                if (collection2 != null)
                {
                    await collection2.MoveToPageAsync(0);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error in OnVirtualCollectionSortChanged: {ex.Message}");
            }
        });
    }



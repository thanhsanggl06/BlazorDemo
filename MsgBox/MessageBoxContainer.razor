@* Components/MessageBoxContainer.razor - Bootstrap Modal Version *@
@inject IMessageBoxService MessageBoxService
@implements IDisposable

@if (isVisible && currentModel != null)
{
    <!-- Bootstrap Modal with Backdrop -->
    <div class="modal fade @(isVisible ? "show" : "")" 
         style="display: @(isVisible ? "block" : "none");"
         tabindex="-1" 
         role="dialog"
         aria-labelledby="messageBoxTitle"
         aria-hidden="@(!isVisible)"
         @onclick="HandleBackdropClick">
        
        <div class="modal-dialog modal-dialog-centered" 
             role="document"
             @onclick:stopPropagation>
            <div class="modal-content shadow-lg">
                
                <!-- Modal Header -->
                <div class="modal-header border-bottom @GetHeaderBorderClass()">
                    <h5 class="modal-title d-flex align-items-center gap-2 @GetHeaderTextClass()" 
                        id="messageBoxTitle">
                        <img src="@GetHeaderIconPath()" alt="icon" width="24" height="24" class="@GetIconClass()" />
                        <span class="fw-semibold">@currentModel.Title</span>
                    </h5>
                    <button type="button" 
                            class="btn-close" 
                            @onclick="() => Close(MessageBoxResult.Cancel)"
                            aria-label="Close"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body py-4">
                    <div class="d-flex align-items-start gap-3">
                        <!-- Icon (Optional) -->
                        @if (currentModel.ShowBodyIcon)
                        {
                            <div class="flex-shrink-0">
                                <img src="@GetIconPath()" 
                                     alt="@currentModel.Type" 
                                     width="48" 
                                     height="48"
                                     class="@GetIconClass()" />
                            </div>
                        }

                        <!-- Message Content -->
                        <div class="flex-grow-1">
                            @if (currentModel.Type == MessageBoxType.Prompt)
                            {
                                <p class="mb-3 text-dark @GetMessageFontClass()">@currentModel.Message</p>
                                <input type="text"
                                       class="form-control form-control-lg"
                                       @bind="promptValue"
                                       @bind:event="oninput"
                                       @ref="promptInput"
                                       placeholder="@currentModel.DefaultValue"
                                       autofocus />
                            }
                            else
                            {
                                <p class="mb-0 text-dark @GetMessageFontClass()">
                                    @((MarkupString)currentModel.Message.Replace("\n", "<br/>"))
                                </p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer border-top bg-light">
                    @switch (currentModel.Buttons)
                    {
                        case MessageBoxButtons.OK:
                            <button type="button" 
                                    class="btn btn-primary px-4"
                                    @onclick="() => Close(MessageBoxResult.OK)">
                                <img src="/icons/check-lg.svg" alt="check" width="16" height="16" class="me-1" />
                                @currentModel.OkButtonText
                            </button>
                            break;

                        case MessageBoxButtons.OKCancel:
                            <button type="button" 
                                    class="btn btn-secondary px-4"
                                    @onclick="() => Close(MessageBoxResult.Cancel)">
                                <img src="/icons/x-lg.svg" alt="cancel" width="16" height="16" class="me-1" />
                                @currentModel.CancelButtonText
                            </button>
                            <button type="button" 
                                    class="btn btn-primary px-4"
                                    @onclick="() => Close(MessageBoxResult.OK)">
                                <img src="/icons/check-lg.svg" alt="ok" width="16" height="16" class="me-1" />
                                @currentModel.OkButtonText
                            </button>
                            break;

                        case MessageBoxButtons.YesNo:
                            <button type="button" 
                                    class="btn btn-outline-secondary px-4"
                                    @onclick="() => Close(MessageBoxResult.No)">
                                <img src="/icons/x-circle.svg" alt="no" width="16" height="16" class="me-1" />
                                @currentModel.NoButtonText
                            </button>
                            <button type="button" 
                                    class="btn btn-primary px-4"
                                    @onclick="() => Close(MessageBoxResult.Yes)">
                                <img src="/icons/check-circle.svg" alt="yes" width="16" height="16" class="me-1" />
                                @currentModel.YesButtonText
                            </button>
                            break;

                        case MessageBoxButtons.YesNoCancel:
                            <button type="button" 
                                    class="btn btn-secondary px-4"
                                    @onclick="() => Close(MessageBoxResult.Cancel)">
                                <img src="/icons/x-lg.svg" alt="cancel" width="16" height="16" class="me-1" />
                                @currentModel.CancelButtonText
                            </button>
                            <button type="button" 
                                    class="btn btn-outline-secondary px-4"
                                    @onclick="() => Close(MessageBoxResult.No)">
                                <img src="/icons/x-circle.svg" alt="no" width="16" height="16" class="me-1" />
                                @currentModel.NoButtonText
                            </button>
                            <button type="button" 
                                    class="btn btn-primary px-4"
                                    @onclick="() => Close(MessageBoxResult.Yes)">
                                <img src="/icons/check-circle.svg" alt="yes" width="16" height="16" class="me-1" />
                                @currentModel.YesButtonText
                            </button>
                            break;
                    }
                </div>

            </div>
        </div>
    </div>

    <!-- Separate Backdrop -->
    @if (currentModel.ShowBackdrop)
    {
        <div class="modal-backdrop fade @(isVisible ? "show" : "")"></div>
    }
}

@code {
    private MessageBoxModel? currentModel;
    private TaskCompletionSource<MessageBoxResult>? taskCompletion;
    private TaskCompletionSource<string>? promptTaskCompletion;
    private string promptValue = "";
    private bool isVisible = false;
    private ElementReference promptInput;

    protected override void OnInitialized()
    {
        MessageBoxService.OnShow += ShowMessageBox;
        MessageBoxService.OnPrompt += ShowPromptBox;
    }

    private async Task<MessageBoxResult> ShowMessageBox(MessageBoxModel model)
    {
        currentModel = model;
        promptValue = model.DefaultValue ?? "";
        taskCompletion = new TaskCompletionSource<MessageBoxResult>();

        await InvokeAsync(async () =>
        {
            StateHasChanged();
            await Task.Delay(10);
            isVisible = true;
            StateHasChanged();
        });

        return await taskCompletion.Task;
    }

    private async Task<string?> ShowPromptBox(string modelJson)
    {
        var model = System.Text.Json.JsonSerializer.Deserialize<MessageBoxModel>(modelJson);
        if (model == null) return null;

        currentModel = model;
        promptValue = model.DefaultValue ?? "";
        promptTaskCompletion = new TaskCompletionSource<string>();

        await InvokeAsync(async () =>
        {
            StateHasChanged();
            await Task.Delay(10);
            isVisible = true;
            StateHasChanged();
        });

        return await promptTaskCompletion.Task;
    }

    private async void Close(MessageBoxResult result)
    {
        // Fade out animation
        isVisible = false;
        StateHasChanged();
        await Task.Delay(150);

        // Complete the task
        if (currentModel?.Type == MessageBoxType.Prompt)
        {
            if (result == MessageBoxResult.OK)
            {
                promptTaskCompletion?.SetResult(promptValue);
            }
            else
            {
                promptTaskCompletion?.SetResult(null);
            }
        }
        else
        {
            taskCompletion?.SetResult(result);
        }

        currentModel = null;
        promptValue = "";
        StateHasChanged();
    }

    private void HandleBackdropClick()
    {
        if (currentModel?.CloseOnBackdropClick == true)
        {
            Close(MessageBoxResult.Cancel);
        }
    }

    private string GetHeaderBorderClass()
    {
        return currentModel?.Type switch
        {
            MessageBoxType.Success => "border-success border-2",
            MessageBoxType.Error => "border-danger border-2",
            MessageBoxType.Warning => "border-warning border-2",
            MessageBoxType.Question => "border-info border-2",
            MessageBoxType.Prompt => "border-secondary border-2",
            _ => "border-primary border-2"
        };
    }

    private string GetHeaderTextClass()
    {
        return currentModel?.Type switch
        {
            MessageBoxType.Success => "text-success",
            MessageBoxType.Error => "text-danger",
            MessageBoxType.Warning => "text-warning",
            MessageBoxType.Question => "text-info",
            MessageBoxType.Prompt => "text-secondary",
            _ => "text-primary"
        };
    }

    private string GetIconClass()
    {
        return currentModel?.Type switch
        {
            MessageBoxType.Success => "icon-success",
            MessageBoxType.Error => "icon-danger",
            MessageBoxType.Warning => "icon-warning",
            MessageBoxType.Question => "icon-info",
            MessageBoxType.Prompt => "icon-secondary",
            _ => "icon-primary"
        };
    }

    private string GetHeaderIconPath()
    {
        return currentModel?.Type switch
        {
            MessageBoxType.Success => "/icons/check-circle-fill.svg",
            MessageBoxType.Error => "/icons/x-circle-fill.svg",
            MessageBoxType.Warning => "/icons/exclamation-triangle-fill.svg",
            MessageBoxType.Question => "/icons/question-circle-fill.svg",
            MessageBoxType.Prompt => "/icons/pencil-square.svg",
            _ => "/icons/info-circle-fill.svg"
        };
    }

    private string GetIconPath()
    {
        return currentModel?.Type switch
        {
            MessageBoxType.Success => "/icons/check-circle-fill.svg",
            MessageBoxType.Error => "/icons/x-circle-fill.svg",
            MessageBoxType.Warning => "/icons/exclamation-triangle-fill.svg",
            MessageBoxType.Question => "/icons/question-circle-fill.svg",
            MessageBoxType.Prompt => "/icons/pencil-square.svg",
            _ => "/icons/info-circle-fill.svg"
        };
    }

    private string GetMessageFontClass()
    {
        return currentModel?.MessageFontSize?.ToLower() switch
        {
            "small" => "message-font-small",
            "large" => "message-font-large",
            _ => "message-font-normal"
        };
    }

    public void Dispose()
    {
        MessageBoxService.OnShow -= ShowMessageBox;
        MessageBoxService.OnPrompt -= ShowPromptBox;
    }
}